        session.active
    ){

        return;

    }


    const today =
        getTodayKey();


    const now =
        new Date();


    const attendanceId =
        `${facultyMobile}_${today}`;


    try{

        const attendanceRef =
            doc(
                db,
                "facultyAttendance",
                attendanceId
            );


        await setDoc(
