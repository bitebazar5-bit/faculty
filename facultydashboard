/* =========================================================
   CHECK OUT
========================================================= */

window.checkOut = async function(){

    if(
        !session.active ||
        !session.checkIn
    ){

        return;

    }


    const now =
        new Date();


    const elapsed =
        now.getTime() -
        session.checkIn.getTime();


    const totalMinutes =
        Math.max(
            0,
            Math.round(
                elapsed / 60000
            )
        );


    const earning =
        (
            totalMinutes / 60
        ) *
        hourlyRate;


    const today =
        getTodayKey();


    try{

        const attendanceRef =
            doc(
                db,
                "facultyAttendance",
                `${facultyMobile}_${today}`
            );


        await updateDoc(
            attendanceRef,
            {

                checkOut:
                    now.toISOString(),

                totalMinutes:
                    totalMinutes,

                hourlyRate:
                    hourlyRate,

                earning:
                    Number(
                        earning.toFixed(2)
                    ),

                updatedAt:
                    serverTimestamp()

            }
        );


        session.active =
            false;


        session.checkOut =
            now;


        session.elapsed =
            elapsed;


        clearInterval(
            timerInterval
        );


        document.getElementById(
            "outTime"
        ).textContent =
            formatTime(now);


        document.getElementById(
            "sessionStatus"
        ).textContent =
            "Class Completed";


        document.getElementById(
            "sessionBadge"
        ).textContent =
            "COMPLETED";


        document.getElementById(
            "sessionBadge"
        ).style.color =
            "#00f2fe";


        document.getElementById(
            "sessionBadge"
        ).style.background =
            "rgba(0,242,254,.08)";


        document.getElementById(
            "checkOutBtn"
        ).disabled =
            true;


        document.getElementById(
            "earningStatus"
        ).textContent =
            "Calculated";


        renderTimer();


        await loadHistory();


        showToast(
            `✓ Class completed. Earned ₹${earning.toFixed(2)}`
        );


    }catch(error){

        console.error(error);


        showToast(
            "Unable to save Check-Out. Check Firebase rules."
        );

    }

};



/* =========================================================
   TIMER
========================================================= */

function startTimer(){

    clearInterval(
        timerInterval
    );


    timerInterval =
        setInterval(
            ()=>{

                if(
                    session.active &&
                    session.checkIn
                ){

                    session.elapsed =
                        Date.now() -
                        session.checkIn.getTime();

                }


                renderTimer();

            },
            1000
        );

}



function renderTimer(){

    const seconds =
        Math.floor(
            session.elapsed /
            1000
        );


    const h =
        Math.floor(
            seconds / 3600
        );


    const m =
        Math.floor(
            (seconds % 3600) /
            60
        );


    const s =
        seconds % 60;


    const pad =
        n =>
            String(n)
            .padStart(2,"0");


    document.getElementById(
        "liveTimer"
    ).textContent =

        `${pad(h)}:${pad(m)}:${pad(s)}`;


    document.getElementById(
        "earningTime"
    ).textContent =

        `${h}h ${m}m`;


    const earning =
        (
            seconds / 3600
        ) *
        hourlyRate;


    document.getElementById(
        "earningBig"
    ).textContent =

        `₹${earning.toFixed(2)}`;


    document.getElementById(
        "todayEarning"
    ).textContent =

        `₹${earning.toFixed(2)}`;

}



/* =========================================================
   LOAD HISTORY
========================================================= */

async function loadHistory(){

    try{

        const q =
            query(

                collection(
                    db,
                    "facultyAttendance"
                ),

                where(
                    "facultyId",
                    "==",
                    facultyMobile
                ),

                orderBy(
                    "date",
                    "desc"
                )

            );


        const snap =
            await getDocs(q);


        allHistory = [];


        snap.forEach(
            docSnap => {

                allHistory.push({

                    id:
                        docSnap.id,

                    ...docSnap.data()

                });

            }
        );


        renderHistory(
            "month"
        );


        calculateSummary();


    }catch(error){

        console.error(
            "History error:",
            error
        );


        document.getElementById(
            "historyList"
        ).innerHTML = `

            <div class="empty">

                <i
                    class="ri-database-2-line"
                    style="font-size:28px;color:#f59e0b"
                ></i>

                <br><br>

                Attendance history unavailable.

                <br>

                Make sure Firestore index/rules are configured.

            </div>

        `;

    }

}



/* =========================================================
   RENDER HISTORY
========================================================= */

function renderHistory(
    filter
){

    const list =
        document.getElementById(
            "historyList"
        );


    let records =
        [...allHistory];


    const now =
        new Date();


    if(
        filter === "month"
    ){

        const month =
            now.getMonth();

        const year =
            now.getFullYear();


        records =
            records.filter(
                item => {

                    const d =
                        new Date(
                            item.date
                        );

                    return (
                        d.getMonth()
                        ===
                        month

                        &&

                        d.getFullYear()
                        ===
                        year
                    );

                }
            );

    }


    if(
        filter === "week"
    ){

        const sevenDays =
            7 *
            24 *
            60 *
            60 *
            1000;


        records =
            records.filter(
                item => {

                    const d =
                        new Date(
                            item.date
                        );


                    return (
                        now - d
                        <=
                        sevenDays
                    );

                }
            );

    }


    if(
        filter === "lastMonth"
    ){

        const month =
            now.getMonth() === 0
            ? 11
            : now.getMonth() - 1;


        const year =
            now.getMonth() === 0
            ? now.getFullYear() - 1
            : now.getFullYear();


        records =
            records.filter(
                item => {

                    const d =
                        new Date(
                            item.date
                        );


                    return (

                        d.getMonth()
                        ===
                        month

                        &&

                        d.getFullYear()
                        ===
                        year

                    );

                }
            );

    }


    if(
        records.length === 0
    ){

        list.innerHTML = `

            <div class="empty">

                <i
                    class="ri-calendar-close-line"
                    style="font-size:28px;color:#64748b"
                ></i>

                <br><br>

                No attendance records found.

            </div>

        `;

        return;

    }


    list.innerHTML = "";


    records.forEach(
        item => {

            const date =
                new Date(
                    item.date
                );


            const dateText =
                date.toLocaleDateString(
                    "en-IN",
                    {
                        day:"2-digit",
                        month:"short"
                    }
                );


            const checkIn =
                item.checkIn
                ?
                formatTime(
                    new Date(
                        item.checkIn
                    )
                )
                :
                "--:--";


            const checkOut =
                item.checkOut
                ?
                formatTime(
                    new Date(
                        item.checkOut
                    )
                )
                :
                "--:--";


            const minutes =
                Number(
                    item.totalMinutes || 0
                );


            const hours =
                Math.floor(
                    minutes / 60
                );


            const mins =
                minutes % 60;


            const earning =
                Number(
                    item.earning || 0
                );


            const row =
                document.createElement(
                    "div"
                );


            row.className =
                "history-row";


            row.innerHTML = `

                <div class="date">

                    ${dateText}

                </div>


                <div>

                    ${checkIn}
                    /
                    ${checkOut}

                </div>


                <div class="duration">

                    ${hours}h
                    ${mins}m

                </div>


                <div class="money">

                    ₹${earning.toFixed(2)}

                </div>

            `;


            list.appendChild(
                row
            );

        }
    );

}



/* =========================================================
   SUMMARY
========================================================= */

function calculateSummary(){

    const now =
        new Date();


    const month =
        now.getMonth();


    const year =
        now.getFullYear();


    const monthRecords =
        allHistory.filter(
            item => {

                const d =
                    new Date(
                        item.date
                    );


                return (

                    d.getMonth()
                    ===
                    month

                    &&

                    d.getFullYear()
                    ===
                    year

                );

            }
        );


    let totalMinutes =
        0;


    let totalEarning =
        0;


    monthRecords.forEach(
        item => {

            totalMinutes +=
                Number(
                    item.totalMinutes || 0
                );


            totalEarning +=
                Number(
                    item.earning || 0
                );

        }
    );


    const hours =
        Math.floor(
            totalMinutes / 60
        );


    const minutes =
        totalMinutes % 60;


    document.getElementById(
        "monthHours"
    ).textContent =

        `${hours}h ${minutes}m`;


    document.getElementById(
        "monthEarning"
    ).textContent =

        `₹${totalEarning.toFixed(2)}`;


    document.getElementById(
        "workDays"
    ).textContent =

        monthRecords.length;

}



/* =========================================================
   FILTER
========================================================= */

window.filterHistory =
function(
    filter,
    button
){

    document
        .querySelectorAll(
            ".filter"
        )
        .forEach(
            btn =>
                btn.classList.remove(
                    "active"
                )
        );


    button.classList.add(
        "active"
    );


    renderHistory(
        filter
    );

};



/* =========================================================
   TOAST
========================================================= */

window.showToast =
function(
    message
){

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    clearTimeout(
        window.toastTimer
    );


    window.toastTimer =
        setTimeout(
            ()=>{

                toast.classList.remove(
                    "show"
                );

            },
            3500
        );

};



/* =========================================================
   START APPLICATION
========================================================= */

async function startApp(){

    await loadFaculty();

    await loadTodayAttendance();

    await loadHistory();

}


startApp();


</script>


