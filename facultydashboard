<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
>

<title>Black Terminal | Faculty Dashboard</title>


<!-- Remix Icon -->

<link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
    rel="stylesheet"
>


<!-- Google Fonts -->

<link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Orbitron:wght@600;800;900&display=swap"
    rel="stylesheet"
>


<style>

/* =========================================================
   ROOT
========================================================= */

:root{

    --bg:#030712;

    --surface:rgba(15,23,42,.55);

    --surface2:rgba(9,13,22,.88);

    --border:rgba(255,255,255,.07);

    --cyan:#00f2fe;

    --blue:#4facfe;

    --purple:#a855f7;

    --pink:#f43f5e;

    --green:#10b981;

    --amber:#f59e0b;

    --text:#f8fafc;

    --muted:#94a3b8;

    --shadow:
        0 18px 45px rgba(0,0,0,.55);

    --grad:
        linear-gradient(
            135deg,
            #00f2fe,
            #4facfe
        );

}


/* =========================================================
   RESET
========================================================= */

*{

    margin:0;

    padding:0;

    box-sizing:border-box;

    font-family:
        'Plus Jakarta Sans',
        sans-serif;

    -webkit-tap-highlight-color:
        transparent;

}


html{

    scroll-behavior:
        smooth;

}


body{

    min-height:100vh;

    color:
        var(--text);

    background:
        var(--bg);

    padding-bottom:
        110px;

    overflow-x:
        hidden;

    background-image:

        radial-gradient(
            circle at 0% 0%,
            rgba(0,242,254,.09),
            transparent 42%
        ),

        radial-gradient(
            circle at 100% 20%,
            rgba(168,85,247,.09),
            transparent 42%
        ),

        radial-gradient(
            circle at 50% 85%,
            rgba(244,63,94,.05),
            transparent 50%
        );

    -webkit-font-smoothing:
        antialiased;

}


button{

    font:inherit;

}


/* =========================================================
   BACKGROUND
========================================================= */

.top-glow{

    position:
        fixed;

    inset:
        -30% -20% auto;

    height:
        400px;

    background:

        radial-gradient(
            circle,
            rgba(0,242,254,.07),
            transparent 65%
        );

    pointer-events:
        none;

    z-index:
        -1;

}


/* =========================================================
   HEADER
========================================================= */

.header{

    padding:
        25px 20px 14px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

}


.profile{

    display:
        flex;

    align-items:
        center;

    gap:
        13px;

}


.avatar{

    width:
        58px;

    height:
        58px;

    border-radius:
        50%;

    padding:
        3px;

    background:

        linear-gradient(
            var(--bg),
            var(--bg)
        ) padding-box,

        var(--grad) border-box;

    border:
        2px solid transparent;

    box-shadow:
        0 0 22px rgba(0,242,254,.2);

}


.avatar img{

    width:
        100%;

    height:
        100%;

    border-radius:
        50%;

    object-fit:
        cover;

}


.eyebrow{

    font-size:
        9px;

    font-weight:
        900;

    color:
        var(--cyan);

    letter-spacing:
        1.4px;

    text-transform:
        uppercase;

}


.name{

    font-size:
        20px;

    font-weight:
        800;

    margin-top:
        3px;

}


.status{

    display:
        flex;

    align-items:
        center;

    gap:
        5px;

    color:
        var(--green);

    font-size:
        9px;

    font-weight:
        800;

    margin-top:
        4px;

}


.dot{

    width:
        7px;

    height:
        7px;

    background:
        var(--green);

    border-radius:
        50%;

    box-shadow:
        0 0 10px var(--green);

}


.menu{

    width:
        42px;

    height:
        42px;

    border-radius:
        14px;

    border:
        1px solid var(--border);

    background:
        rgba(255,255,255,.03);

    color:
        #fff;

    font-size:
        21px;

}


/* =========================================================
   DATE
========================================================= */

.datebar{

    margin:
        0 20px 16px;

    padding:
        12px 15px;

    border:
        1px solid var(--border);

    border-radius:
        16px;

    background:
        rgba(15,23,42,.42);

    backdrop-filter:
        blur(18px);

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    color:
        var(--muted);

    font-size:
        11px;

    font-weight:
        700;

}


.datebar i{

    color:
        var(--cyan);

    font-size:
        17px;

}


/* =========================================================
   LABEL
========================================================= */

.label{

    padding:
        0 20px;

    margin:
        24px 0 11px;

    font-size:
        10px;

    font-weight:
        900;

    letter-spacing:
        1.5px;

    text-transform:
        uppercase;

    color:
        #94a3b8;

    display:
        flex;

    align-items:
        center;

    gap:
        7px;

}


.label i{

    font-size:
        14px;

    color:
        var(--cyan);

}


/* =========================================================
   CARD
========================================================= */

.card{

    margin:
        0 20px;

    border:
        1px solid var(--border);

    border-radius:
        24px;

    background:
        var(--surface);

    backdrop-filter:
        blur(25px);

    -webkit-backdrop-filter:
        blur(25px);

    box-shadow:
        var(--shadow);

}


/* =========================================================
   ATTENDANCE
========================================================= */

.att-card{

    padding:
        22px;

    position:
        relative;

    overflow:
        hidden;

}


.att-card:after{

    content:
        '';

    position:
        absolute;

    width:
        180px;

    height:
        180px;

    right:
        -90px;

    top:
        -90px;

    background:

        radial-gradient(
            circle,
            rgba(0,242,254,.15),
            transparent 65%
        );

    pointer-events:
        none;

}


.card-head{

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        flex-start;

}


.small-title{

    font-size:
        10px;

    font-weight:
        900;

    letter-spacing:
        1px;

    color:
        var(--muted);

    text-transform:
        uppercase;

}


.big-status{

    font-size:
        21px;

    font-weight:
        800;

    margin-top:
        5px;

}


.live-badge{

    font-size:
        8px;

    font-weight:
        900;

    padding:
        5px 9px;

    border-radius:
        8px;

    text-transform:
        uppercase;

    background:
        rgba(245,158,11,.12);

    color:
        var(--amber);

    border:
        1px solid rgba(245,158,11,.3);

}


/* =========================================================
   TIMER
========================================================= */

.timer{

    text-align:
        center;

    font-family:
        Orbitron,
        sans-serif;

    font-size:
        34px;

    font-weight:
        800;

    letter-spacing:
        2px;

    margin:
        25px 0 8px;

    text-shadow:
        0 0 18px rgba(0,242,254,.22);

}


.timer-sub{

    text-align:
        center;

    color:
        var(--muted);

    font-size:
        10px;

    font-weight:
        600;

}


/* =========================================================
   TIME
========================================================= */

.time-row{

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        10px;

    margin-top:
        22px;

}


.time-box{

    padding:
        13px;

    border:
        1px solid var(--border);

    border-radius:
        16px;

    background:
        rgba(255,255,255,.025);

}


.time-box span{

    display:
        block;

    color:
        #64748b;

    font-size:
        8px;

    font-weight:
        900;

    text-transform:
        uppercase;

    letter-spacing:
        1px;

}


.time-box strong{

    display:
        block;

    font-size:
        14px;

    margin-top:
        4px;

}


/* =========================================================
   ACTIONS
========================================================= */

.actions{

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        10px;

    margin-top:
        12px;

}


.action{

    border:
        0;

    border-radius:
        15px;

    padding:
        14px;

    font-size:
        11px;

    font-weight:
        900;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    gap:
        7px;

    cursor:
        pointer;

}


.checkin{

    background:
        var(--grad);

    color:
        #03101b;

    box-shadow:
        0 7px 20px rgba(0,242,254,.18);

}


.checkout{

    background:
        rgba(244,63,94,.12);

    color:
        #fb7185;

    border:
        1px solid rgba(244,63,94,.28);

}


.action:disabled{

    opacity:
        .35;

    cursor:
        not-allowed;

}


/* =========================================================
   RATE
========================================================= */

.rate-strip{

    margin-top:
        15px;

    padding:
        11px 13px;

    border-radius:
        14px;

    background:
        rgba(16,185,129,.07);

    border:
        1px solid rgba(16,185,129,.15);

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

}


.rate-strip span{

    font-size:
        9px;

    color:
        #94a3b8;

    font-weight:
        700;

}


.rate-strip strong{

    font-family:
        Orbitron;

    font-size:
        14px;

    color:
        var(--green);

}


/* =========================================================
   STATS
========================================================= */

.stats{

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        12px;

    padding:
        0 20px;

}


.stat{

    min-height:
        125px;

    padding:
        17px;

    border:
        1px solid var(--border);

    border-radius:
        20px;

    background:
        var(--surface);

    backdrop-filter:
        blur(20px);

    box-shadow:
        var(--shadow);

}


.stat i{

    font-size:
        22px;

    display:
        block;

    margin-bottom:
        12px;

}


.stat h3{

    font-size:
        21px;

    font-family:
        Orbitron;

    font-weight:
        800;

}


.stat p{

    font-size:
        9px;

    color:
        #64748b;

    font-weight:
        800;

    text-transform:
        uppercase;

    letter-spacing:
        .7px;

    margin-top:
        5px;

}


.cyan{
    color:var(--cyan);
}


.green{
    color:var(--green);
}


.amber{
    color:var(--amber);
}


.purple{
    color:var(--purple);
}


/* =========================================================
   EARNING
========================================================= */

.earning{

    margin:
        0 20px;

    padding:
        20px;

    border-radius:
        22px;

    background:

        linear-gradient(
            135deg,
            rgba(168,85,247,.14),
            rgba(244,63,94,.08)
        );

    border:
        1px solid rgba(168,85,247,.2);

    box-shadow:
        var(--shadow);

}


.earning-top{

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

}


.earning h2{

    font-size:
        27px;

    font-family:
        Orbitron;

    margin-top:
        5px;

}


.earning-icon{

    width:
        44px;

    height:
        44px;

    border-radius:
        14px;

    background:
        rgba(168,85,247,.14);

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    font-size:
        22px;

    color:
        #c084fc;

}


.breakdown{

    display:
        grid;

    grid-template-columns:
        1fr 1fr 1fr;

    gap:
        8px;

    margin-top:
        17px;

}


.breakdown div{

    padding:
        10px;

    border-radius:
        13px;

    background:
        rgba(255,255,255,.035);

}


.breakdown span{

    font-size:
        8px;

    color:
        #64748b;

    font-weight:
        800;

    display:
        block;

}


.breakdown strong{

    font-size:
        11px;

    display:
        block;

    margin-top:
        3px;

}


/* =========================================================
   FILTER
========================================================= */

.filters{

    display:
        flex;

    gap:
        8px;

    padding:
        0 20px;

    overflow-x:
        auto;

    scrollbar-width:
        none;

}


.filters::-webkit-scrollbar{

    display:
        none;

}


.filter{

    flex:
        0 0 auto;

    padding:
        9px 13px;

    border-radius:
        12px;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid var(--border);

    color:
        #94a3b8;

    font-size:
        9px;

    font-weight:
        800;

}


.filter.active{

    color:
        #03101b;

    background:
        var(--grad);

    border-color:
        transparent;

}


/* =========================================================
   HISTORY
========================================================= */

.history-card{

    padding:
        6px 0;

    overflow:
        hidden;

}


.history-row{

    display:
        grid;

    grid-template-columns:
        1.1fr .9fr .9fr .8fr;

    gap:
        6px;

    padding:
        15px 16px;

    border-bottom:
        1px solid rgba(255,255,255,.05);

    align-items:
        center;

}


.history-row:last-child{

    border-bottom:
        0;

}


.history-row.header-row{

    padding-top:
        12px;

    padding-bottom:
        9px;

    color:
        #64748b;

    font-size:
        8px;

    font-weight:
        900;

    text-transform:
        uppercase;

    letter-spacing:
        .5px;

}


.history-row div{

    font-size:
        10px;

    font-weight:
        700;

}


.history-row .date{

    color:
        #cbd5e1;

}


.history-row .duration{

    color:
        var(--cyan);

}


.history-row .money{

    color:
        var(--green);

    font-family:
        Orbitron;

    font-size:
        9px;

}


/* =========================================================
   EMPTY
========================================================= */

.empty{

    text-align:
        center;

    padding:
        28px 15px;

    color:
        #64748b;

    font-size:
        11px;

}


/* =========================================================
   BOTTOM NAV
========================================================= */

.bottom{

    position:
        fixed;

    z-index:
        1000;

    bottom:
        18px;

    left:
        18px;

    right:
        18px;

    background:
        rgba(9,13,22,.88);

    border:
        1px solid var(--border);

    border-radius:
        24px;

    backdrop-filter:
        blur(28px);

    display:
        flex;

    justify-content:
        space-around;

    padding:
        12px 7px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.7);

}


.nav{

    color:
        #64748b;

    text-decoration:
        none;

    text-align:
        center;

    font-size:
        8px;

    font-weight:
        800;

}


.nav i{

    font-size:
        21px;

    display:
        block;

    margin-bottom:
        3px;

}


.nav.active{

    color:
        var(--cyan);

}


/* =========================================================
   TOAST
========================================================= */

.toast{

    position:
        fixed;

    left:
        20px;

    right:
        20px;

    bottom:
        105px;

    z-index:
        2000;

    padding:
        13px 15px;

    border-radius:
        15px;

    background:
        rgba(9,13,22,.95);

    border:
        1px solid rgba(0,242,254,.25);

    box-shadow:
        0 12px 30px #000;

    transform:
        translateY(140%);

    transition:
        .35s ease;

    font-size:
        11px;

    font-weight:
        700;

}


.toast.show{

    transform:
        translateY(0);

}


/* =========================================================
   DESKTOP
========================================================= */

@media(min-width:700px){

    body{

        max-width:
            700px;

        margin:
            auto;

    }


    .bottom{

        max-width:
            664px;

        margin:
            auto;

    }


    .toast{

        max-width:
            660px;

        margin:
            auto;

    }

}

</style>

</head>



<body>


<div class="top-glow"></div>


<!-- =========================================================
     HEADER
========================================================= -->

<header class="header">

    <div class="profile">


        <div class="avatar">

            <img
                id="facultyPhoto"
                src="https://api.dicebear.com/7.x/avataaars/svg?seed=Faculty"
                alt="Faculty"
            >

        </div>


        <div>

            <div class="eyebrow">

                Black Terminal • Faculty Core

            </div>


            <div
                class="name"
                id="facultyName"
            >

                Faculty Name

            </div>


            <div class="status">

                <span class="dot"></span>

                Active Faculty Node

            </div>

        </div>

    </div>


    <button
        class="menu"
        onclick="showToast('Faculty profile settings')"
    >

        <i class="ri-more-2-fill"></i>

    </button>

</header>



<!-- =========================================================
     DATE BAR
========================================================= -->

<div class="datebar">


    <span>

        <i class="ri-calendar-line"></i>

        &nbsp;

        <span id="todayDate">
            Loading date...
        </span>

    </span>


    <span id="liveClock">
        --:--:--
    </span>


</div>



<!-- =========================================================
     TODAY ATTENDANCE
========================================================= -->

<div class="label">

    <i class="ri-fingerprint-fill"></i>

    Today's Class Attendance

</div>



<section class="card att-card">


    <div class="card-head">


        <div>

            <div class="small-title">
                Current Session
            </div>


            <div
                class="big-status"
                id="sessionStatus"
            >

                Ready to Start

            </div>

        </div>


        <span
            class="live-badge"
            id="sessionBadge"
        >

            OFFLINE

        </span>

    </div>



    <!-- TIMER -->

    <div
        class="timer"
        id="liveTimer"
    >

        00:00:00

    </div>


    <div class="timer-sub">

        Total class time today

    </div>



    <!-- TIMES -->

    <div class="time-row">


        <div class="time-box">

            <span>
                Check In
            </span>

            <strong id="inTime">
                --:--
            </strong>

        </div>


        <div class="time-box">

            <span>
                Check Out
            </span>

            <strong id="outTime">
                --:--
            </strong>

        </div>


    </div>



    <!-- BUTTONS -->

    <div class="actions">


        <button
            class="action checkin"
            id="checkInBtn"
            onclick="checkIn()"
        >

            <i class="ri-login-circle-line"></i>

            CHECK IN

        </button>


        <button
            class="action checkout"
            id="checkOutBtn"
            onclick="checkOut()"
            disabled
        >

            <i class="ri-logout-circle-line"></i>

            CHECK OUT

        </button>


    </div>



    <!-- HOURLY RATE -->

    <div class="rate-strip">


        <span>

            <i class="ri-lock-line"></i>

            ADMIN CONTROLLED HOURLY RATE

        </span>


        <strong id="hourlyRate">

            ₹0/hr

        </strong>


    </div>


</section>



<!-- =========================================================
     PERFORMANCE
========================================================= -->

<div class="label">

    <i class="ri-bar-chart-box-line"></i>

    Performance Summary

</div>



<section class="stats">


    <div class="stat">

        <i class="ri-time-line cyan"></i>

        <h3 id="monthHours">
            0h 0m
        </h3>

        <p>
            This Month Hours
        </p>

    </div>



    <div class="stat">

        <i class="ri-wallet-3-line green"></i>

        <h3 id="monthEarning">
            ₹0
        </h3>

        <p>
            This Month Earning
        </p>

    </div>



    <div class="stat">

        <i class="ri-calendar-check-line amber"></i>

        <h3 id="workDays">
            0
        </h3>

        <p>
            Working Days
        </p>

    </div>



    <div class="stat">

        <i class="ri-money-rupee-circle-line purple"></i>

        <h3 id="todayEarning">
            ₹0
        </h3>

        <p>
            Today's Earning
        </p>

    </div>


</section>



<!-- =========================================================
     EARNING
========================================================= -->

<div class="label">

    <i class="ri-funds-box-line"></i>

    Earnings Calculator

</div>



<section class="earning">


    <div class="earning-top">


        <div>

            <div class="small-title">
                Today's Estimated Pay
            </div>


            <h2 id="earningBig">
                ₹0.00
            </h2>

        </div>


        <div class="earning-icon">

            <i class="ri-money-rupee-circle-fill"></i>

        </div>


    </div>



    <div class="breakdown">


        <div>

            <span>
                CLASS TIME
            </span>

            <strong id="earningTime">
                0h 0m
            </strong>

        </div>


        <div>

            <span>
                RATE
            </span>

            <strong id="earningRate">
                ₹0/hr
            </strong>

        </div>


        <div>

            <span>
                STATUS
            </span>

            <strong id="earningStatus">
                Pending
            </strong>

        </div>


    </div>


</section>



<!-- =========================================================
     HISTORY
========================================================= -->

<div class="label">

    <i class="ri-history-line"></i>

    Attendance History

</div>



<div class="filters">


    <button
        class="filter active"
        onclick="filterHistory('month',this)"
    >
        This Month
    </button>


    <button
        class="filter"
